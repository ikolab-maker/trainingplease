# --- Cliente (opcionales: por defecto se usa el proyecto "trainingplease" de src/lib/firebase.ts) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Servidor (SECRETAS: solo en Vercel o en .env.local, nunca en el repo) ---
# JSON completo de la cuenta de servicio de Firebase, en una sola línea.
FIREBASE_SERVICE_ACCOUNT=
# Correos de Google que entran como admin/coach (separados por coma).
ADMIN_EMAILS=
