{
  "name": "train-please-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts src/lib/agent/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-trainplease \"node --test tests/rules.test.mjs\"",
    "dev:emu": "firebase emulators:exec --only auth,firestore --project demo-trainplease \"next dev\"",
    "seed:plan": "node scripts/seed-plan.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.32.1",
    "typescript": "^5.9.3"
  }
}
