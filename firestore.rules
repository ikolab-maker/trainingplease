rules_version = '2';

// Training Please · reglas de Firestore
// - El rol viene del custom claim `role` que pone el servidor (Admin SDK).
// - El atleta solo lee y escribe lo suyo; solo admin escribe planes.
// - Si el atleta revoca el consentimiento, el coach deja de ver sus registros.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function hasConsent(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && userDoc(uid).data.get('consent', null) != null;
    }

    // Perfil. Lo crea el servidor al primer acceso; el atleta edita solo campos propios.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['theme', 'profile', 'goalRace', 'consent', 'lang', 'updatedAt'])
        && request.resource.data.get('lang', 'es') in ['es', 'en'];
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'consent']);
      allow create, delete: if false;
    }

    // Alta manual de atletas: la gestiona el servidor. El admin solo la consulta.
    match /allowlist/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Formularios del sitio público: los escribe el servidor; solo el coach los lee.
    match /pilotRequests/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /investorContacts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Evidencia del consentimiento: solo se agregan eventos, nunca se editan ni borran.
    match /consents/{uid}/events/{eventId} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.action in ['granted', 'revoked']
        && request.resource.data.version is string
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Plan semanal: lo escribe el coach; el atleta lo lee.
    match /plans/{uid}/weeks/{weekId} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();

      match /sessions/{sessionId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Registro del atleta por sesión (realizada, RPE real, comentario).
    match /logs/{uid}/entries/{sessionId} {
      allow read: if isSelf(uid) || (isAdmin() && hasConsent(uid));
      allow create, update: if isSelf(uid) && hasConsent(uid) && validLog();
      allow delete: if isSelf(uid);
    }

    // Blog del club. Publicados: todos leen los públicos; los privados, solo quien tiene cuenta.
    // Borradores: solo el coach. Los likes y los envíos los escribe el servidor.
    function isMember() { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))); }

    match /posts/{slug} {
      allow read: if isAdmin()
        || (resource.data.status == 'published' && (resource.data.private == false || isMember()));
      allow create: if isAdmin() && validPost(slug)
        && request.resource.data.likes == 0 && !('sends' in request.resource.data);
      allow update: if isAdmin() && validPost(slug)
        && request.resource.data.likes == resource.data.likes
        && request.resource.data.get('sends', null) == resource.data.get('sends', null);
      allow delete: if isAdmin();

      // Like de cada usuario (id = uid) o anónimo (id = a_<hash>). Cada uno ve solo el suyo.
      match /likes/{key} {
        allow read: if isSelf(key);
        allow write: if false;
      }
    }

    function validContent(c) {
      return c is map && c.keys().hasOnly(['title', 'summary', 'body'])
        && c.title is string && c.title.size() > 0 && c.title.size() <= 140
        && c.summary is string && c.summary.size() <= 300
        && c.body is string && c.body.size() <= 20000;
    }

    function validPost(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly(['slug', 'es', 'en', 'private', 'status', 'likes', 'sends', 'createdAt', 'updatedAt', 'publishedAt'])
        && d.slug == slug && slug.size() <= 80 && slug.matches('[a-z0-9]+(-[a-z0-9]+)*')
        && validContent(d.es)
        && (d.get('en', null) == null || validContent(d.en))
        && d.private is bool
        && d.status in ['draft', 'published']
        && d.updatedAt == request.time;
    }

    function validLog() {
      let d = request.resource.data;
      return d.keys().hasOnly(['done', 'rpe', 'comment', 'link', 'weekId', 'updatedAt'])
        && d.done is bool
        && d.weekId is string
        && (d.rpe == null || (d.rpe is int && d.rpe >= 1 && d.rpe <= 10))
        && (d.comment is string && d.comment.size() <= 1000)
        && (!('link' in d) || (d.link is string && d.link.size() <= 300 && d.link.matches('https://.+')))
        && d.updatedAt == request.time;
    }
  }
}
